#!/bin/bash
# 루프 세션 안의 godot — 창을 띄우지 않는다. 사람이 이 맥을 같이 쓰기 때문이다.
# 창이 필요하면 harness/shot.sh 를 쓴다 (포커스·마우스와 섞이지 않게 해 둠).
real="${NARU_REAL_GODOT:?NARU_REAL_GODOT 없음}"
[ -n "${NARU_ALLOW_WINDOW:-}" ] && exec "$real" "$@"
for a in "$@"; do [ "$a" = "--headless" ] && exec "$real" "$@"; done
exec "$real" --headless "$@"
